# Bitacora - configuracion.
# Copiar este archivo como .env y ajustar. Ningun valor es obligatorio:
# todos tienen un valor por defecto razonable.

# --- Fase 1 (nucleo + MCP stdio) --------------------------------------------

# Zona horaria con la que el servidor sella "fecha" y "hora" de cada nota.
# Es la zona del usuario, no la del sistema.
BITACORA_TZ=America/Montevideo

# Base para las URLs que devuelve save_note. El puerto tiene que coincidir con
# el de la web cuando exista (fase 2).
BITACORA_WEB_URL=http://127.0.0.1:8787

# Carpeta de datos. Por defecto ./data dentro del repo.
# En Windows usar barras normales o barras invertidas dobles.
# BITACORA_DATA_DIR=C:/Users/usuario/bitacora/data

# Archivo de la base. Por defecto <BITACORA_DATA_DIR>/bitacora.db
# BITACORA_DB_PATH=C:/Users/usuario/bitacora/data/bitacora.db

# --- Fase 2 (web) -----------------------------------------------------------

# Contrasena unica de la interfaz web. Se guarda hasheada en la base la primera
# vez que arranca; despues se cambia desde Ajustes.
# BITACORA_PASSWORD=

# Puerto del servidor web. Escucha solo en 127.0.0.1.
# BITACORA_PORT=8787

# --- Fase 3 (acceso remoto por Cloudflare Tunnel) ---------------------------

# URL publica del tunel. Es el "issuer" de OAuth 2.1, tiene que ser https.
# BITACORA_PUBLIC_URL=https://bitacora.midominio.com

# --- Fase 4 (importacion del export de claude.ai) ---------------------------

# Opcional. Si esta, aparece el boton "Generar resumen" en /importar.
# ANTHROPIC_API_KEY=
